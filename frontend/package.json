{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" vite.config.ts vitest.config.ts tailwind.config.js postcss.config.js",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" vite.config.ts vitest.config.ts tailwind.config.js postcss.config.js",
    "lint": "oxlint src",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@stomp/stompjs": "^7.3.0",
    "@tanstack/react-query": "^5.59.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.1.0",
    "recharts": "^2.13.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.1.0",
    "oxlint": "^1.78.0",
    "postcss": "^8.4.49",
    "prettier": "3.9.6",
    "tailwindcss": "^3.4.15",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "4.1.10"
  }
}
