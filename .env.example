# MongoDB Local Configuration
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=example_password
MONGO_DATABASE=log_monitor
MONGODB_URI=mongodb://root:example_password@localhost:27017/log_monitor?authSource=admin

# Backend Application Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# Security & Credentials (Set secure random strings in real environment)
JWT_SECRET=change_this_to_a_very_long_and_secure_secret_key_at_least_256_bits_long
JWT_EXPIRATION_MS=900000
AUTH_LOGIN_BURST_CAPACITY=5
AUTH_LOGIN_WINDOW_SECONDS=60
AUTH_REFRESH_TOKEN_EXPIRATION_SECONDS=604800
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAME_SITE=Strict

# Optional idempotent local-only first administrator bootstrap
LOCAL_BOOTSTRAP_ADMIN_ENABLED=false
LOCAL_BOOTSTRAP_ORGANIZATION_ID=local-org
LOCAL_BOOTSTRAP_ORGANIZATION_SLUG=local
LOCAL_BOOTSTRAP_ORGANIZATION_NAME=Local Development
LOCAL_BOOTSTRAP_ADMIN_USERNAME=local-admin
LOCAL_BOOTSTRAP_ADMIN_EMAIL=admin@example.test
LOCAL_BOOTSTRAP_ADMIN_PASSWORD=replace_with_at_least_12_characters

# Ingestion Queue & Worker Default Tuning
INGESTION_QUEUE_CAPACITY=50000
INGESTION_WORKER_COUNT=4
INGESTION_BATCH_MAX_SIZE=500
INGESTION_BATCH_MAX_WAIT_MS=500
INGESTION_ENQUEUE_TIMEOUT_MS=5
INGESTION_MAX_HTTP_BODY_BYTES=1048576
INGESTION_MAX_MESSAGE_LENGTH=4000
INGESTION_MAX_STACK_TRACE_LENGTH=16000
INGESTION_MAX_CONTEXT_BYTES=32768
INGESTION_MAX_CONTEXT_KEYS=50
INGESTION_MAX_CONTEXT_DEPTH=5
LOG_REDACTION_ENABLED=true
LOG_REDACTION_REPLACEMENT=[REDACTED]

# Alerting Mode (mock, telegram, slack)
ALERT_NOTIFICATION_MODE=mock

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_WS_URL=ws://localhost:8080/ws
